        <record model="ir.ui.view" id="add_shelfs_page_in_product_temlate_form_view">
            <field name="name">Add shelf page to the product</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Shelfs" name="product_shelfs">
                        <field name="product_shelf_ids">
                            <tree string="Shelfs" editable="bottom">
                                <field name="shelf_id"></field>
                                <field name="quantity"></field>
                            </tree>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>